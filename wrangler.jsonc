{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "weoracle-online",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2026-07-30",
	"compatibility_flags": ["nodejs_compat"],
	"assets": {
		"directory": ".svelte-kit/cloudflare",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},
	"routes": [
		{ "pattern": "weoracle.online", "custom_domain": true },
		{ "pattern": "www.weoracle.online", "custom_domain": true }
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "weoracle",
			"database_id": "bd0ad86d-c72a-427b-bcb1-ad492b0681b5"
		}
	],
	"kv_namespaces": [
		{ "binding": "KV", "id": "9669d9efd3694d83a1c9a7df0849b9cd" }
	],
	"r2_buckets": [
		{ "binding": "BUCKET", "bucket_name": "weoracle-online" }
	],
	"send_email": [{ "name": "EMAIL" }]
}
